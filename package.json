{
  "name": "dsh-rss-news-zhuikan",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "dsh companion plugin: subscribe to ordinary list pages that have no RSS feed — AI learns the page structure, new items flow into the main news feed.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "web",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-llm": "*",
    "dsh-rss-news-daily": "^1.1.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@types/node": "^22.0.0",
    "dsh-rss-news-daily": "file:../dsh-rss-news-daily",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-vendor.mjs && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "rss",
    "news",
    "web-scraping",
    "ai",
    "feed",
    "watchlist"
  ],
  "author": "terry2010 <jstel@126.com>",
  "homepage": "https://github.com/terry2010/dsh-rss-news-zhuikan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terry2010/dsh-rss-news-zhuikan.git"
  },
  "bugs": "https://github.com/terry2010/dsh-rss-news-zhuikan/issues"
}
